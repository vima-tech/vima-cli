{
  "statusLine": {
    "type": "command",
    "command": "vima status --line"
  },
  "permissions": {
    "allow": [
      "Read", "Write", "Edit",
      "Bash(npm run *)", "Bash(mvn *)",
      "Bash(git status *)", "Bash(git add *)", "Bash(git commit *)", "Bash(git log *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(find *)", "Bash(grep *)",
      "Bash(vima *)"
    ],
    "deny": [
      "Bash(rm -rf *)", "Bash(sudo *)", "Bash(curl *)", "Bash(wget *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/go-autostart.mjs\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shared.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-write.mjs\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/go-continue.mjs\"" }
        ]
      }
    ]
  }
}
