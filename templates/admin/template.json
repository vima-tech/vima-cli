{
  "id": "admin",
  "name": "管理后台",
  "status": "stable",
  "description": "完整管理后台：登录认证 + RBAC 系统管理模块 + vendored 组件库 + PostgreSQL/Redis 基础组件",
  "version": "2.0.0",
  "techStack": {
    "frontend": "Vue 3 + TypeScript + Vite + vendored @vima-tech/ui-admin",
    "backend": "Java 21 + Spring Boot + JPA + Spring Security（Redis 登录态 + RBAC）",
    "database": "PostgreSQL（默认必需）+ Redis（登录态与权限缓存，必需）"
  },
  "features": [
    "登录认证（Redis 登录态：滑动续期/单会话/可强制作废）",
    "RBAC 系统管理模块（用户/角色/菜单/部门/字典/配置/文件/日志/消息）",
    "vendored 组件库（vendor/，离线可用）",
    "PostgreSQL + Redis 基础组件（附 docker-compose，可切换 MySQL/信创库）",
    "按钮级权限（后端 @PreAuthorize + 前端按 perms 串控制按钮，admin 通配 *）",
    "在线用户监控（查看在线列表 + 强制下线）",
    "定时任务管理（新增/编辑/启停/立即执行）",
    "Excel 导入导出（Apache POI，用户模块内置示例）",
    "API 文档（springdoc-openapi，/swagger-ui 在线调试）",
    "用户信息接口返回 perms 与可见菜单（前端权限渲染依据）"
  ],
  "prerequisites": [
    {
      "tool": "node",
      "check": "node --version",
      "constraint": ">=20"
    },
    {
      "tool": "java",
      "check": "java --version",
      "constraint": ">=21",
      "optional": true,
      "hint": "缺失不阻断创建，但无法本地运行后端"
    },
    {
      "tool": "maven",
      "check": "mvn --version",
      "constraint": ">=3.9",
      "optional": true,
      "hint": "缺失不阻断：backend/mvnw 首次运行会自动下载 Maven（需联网）"
    }
  ],
  "apps": [
    {
      "id": "admin",
      "name": "管理后台",
      "kind": "admin-web",
      "default": true,
      "scaffold": "scaffold/frontend",
      "uiDocs": "ui-docs",
      "codeDir": "src",
      "sharedDirs": [
        "src/components",
        "src/utils",
        "vendor"
      ]
    },
    {
      "id": "mp",
      "name": "小程序",
      "kind": "mp-native",
      "scaffold": "scaffold/mp-native",
      "uiDocs": "ui-docs-vm",
      "codeDir": "src",
      "sharedDirs": [
        "src/components",
        "src/utils",
        "src/vendor"
      ]
    },
    {
      "id": "h5",
      "name": "移动端 H5",
      "kind": "h5-mobile",
      "scaffold": "scaffold/h5-mobile",
      "uiDocs": "ui-docs-vm",
      "codeDir": "src",
      "sharedDirs": [
        "src/components",
        "src/utils",
        "vendor"
      ]
    }
  ],
  "backend": {
    "scaffold": "scaffold/backend",
    "dir": "backend",
    "sharedDirs": [
      "src/main/java/com/{{projectPkg}}/config",
      "src/main/java/com/{{projectPkg}}/security"
    ]
  },
  "root": {
    "scaffold": "scaffold/root"
  },
