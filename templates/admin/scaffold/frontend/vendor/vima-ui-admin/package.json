{
  "name": "@vima-tech/ui-admin",
  "version": "0.1.0",
  "description": "Vima UI Admin — 政企后台 Vue 3 组件库（vendor 副本，仅含 dist 构建产物）",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./agent/schema/app-spec.v1.json": "./dist/agent/schema/app-spec.v1.json",
    "./agent/docs/README.md": "./dist/agent/docs/README.md",
    "./agent/docs/SKILL.md": "./dist/agent/docs/SKILL.md",
    "./agent/docs/recipes/index.json": "./dist/agent/docs/recipes/index.json",
    "./agent/docs/recipes/*": "./dist/agent/docs/recipes/*",
    "./style.css": "./dist/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./ui.css": "./dist/styles/ui.css",
    "./ai-manifest.json": "./dist/ai-manifest.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
