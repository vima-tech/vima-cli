/**
 * 全局样式入口。
 *
 * 纪律：本文件只做三件事——引框架、设页面底色、（可选）引主题。
 * 业务样式一律写在各自页面的 .wxss 里，通用样式提到 vendor/vima-ui-mp（须走共享层令牌）。
 */

@import "/vendor/vima-ui-mp/dist/ui.wxss";

/* 换肤：取消下面这行的注释即切到临床蓝（Sustain 原型口径），顺序必须在 ui.wxss 之后。 */
/* @import "/vendor/vima-ui-mp/dist/themes/clinical-blue.wxss"; */

/*
 * page 元素在 .vm-page 之外，令牌够不着，这里是全工程唯一允许的裸色值——
 * 取值必须与 tokens.wxss 的 --vm-bg 一致（换肤时两处一起改）。
 * app.json 的 tabBar 配色同理（JSON 里用不了 CSS 变量）：
 *   color #7d8ba2 = --vm-text-weak，selectedColor #2f73c5 = --vm-primary。
 */
page {
  background-color: #e9f0f7;
}
