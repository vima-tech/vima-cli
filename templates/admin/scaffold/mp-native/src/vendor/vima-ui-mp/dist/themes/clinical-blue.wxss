/**
 * 备选主题 · 临床蓝（clinical-blue）
 *
 * 取值来路：`Sustain/docs/院外营养患者管理系统原型设计` 两份设计画布
 * （`移动端·患者随访小程序.dc.html` / `后台端·营养随访管理系统.dc.html`）实测色频统计——
 * 主色 #409EFF（90/174 次）、深蓝 #337ECC、深灰蓝 #304156、页底 #F5F7FA、
 * 三态 #67C23A / #E6A23C / #F56C6C、边框 #DCDFE6 / #EBEEF5、浅蓝底 #ECF5FF。
 *
 * 用法（app.wxss，放在 ui.wxss 之后，顺序不能反）：
 *   @import "/vendor/vima-ui-mp/dist/ui.wxss";
 *   @import "/vendor/vima-ui-mp/dist/themes/clinical-blue.wxss";
 *
 * 纪律：主题文件**只覆盖令牌，不含任何类样式**——一旦在这里写类，换肤就变成了改框架。
 * 尺寸 / 字阶 / 圆角一律不覆盖：换的是品牌色，不是版式。
 */

page,
.vm-page {
  --vm-navy-900: #304156;
  --vm-navy-700: #4a5b70;
  --vm-primary: #409eff;
  --vm-primary-strong: #337ecc;
  --vm-cyan: #36cfc9;

  --vm-bg: #f5f7fa;
  --vm-surface: #ffffff;
  --vm-surface-soft: #fafcff;
  --vm-border: #dcdfe6;
  --vm-border-soft: #ebeef5;

  --vm-text-title: #303133;
  --vm-text-body: #4a5563;
  --vm-text-sub: #606266;
  --vm-text-weak: #909399;
  --vm-text-faint: #a8abb2;
  --vm-on-dark-body: #c7d6e6;
  --vm-on-dark-accent: #e8f3ff;

  --vm-accent-blue: #409eff;
  --vm-accent-cyan: #36cfc9;
  --vm-accent-green: #67c23a;
  --vm-accent-indigo: #6a72e8;
  --vm-accent-amber: #e6a23c;
  --vm-accent-red: #f56c6c;
  --vm-accent-violet: #8b5cf6;

  --vm-soft-blue: #ecf5ff;
  --vm-soft-cyan: #e6fffb;
  --vm-soft-green: #f0f9eb;
  --vm-soft-indigo: #eef0fd;
  --vm-soft-amber: #fdf6ec;
  --vm-soft-red: #fef0f0;
  --vm-soft-violet: #f4efff;

  --vm-disabled: #c0c4cc;

  --vm-hero-grad:
    radial-gradient(circle at 82% -15%, rgba(54, 207, 201, 0.2), transparent 34%),
    linear-gradient(155deg, #22303f 0%, var(--vm-navy-900) 48%, var(--vm-navy-700) 100%);
  --vm-hero-glow: radial-gradient(circle, rgba(64, 158, 255, 0.18), rgba(64, 158, 255, 0) 68%);
  --vm-page-grad:
    radial-gradient(circle at 92% 9%, rgba(64, 158, 255, 0.07), transparent 25%),
    linear-gradient(180deg, #f9fbfd 0%, #f5f7fa 42%, #f2f5f9 100%);
  --vm-btn-grad: linear-gradient(135deg, #337ecc 0%, #409eff 62%, #52b0ff 120%);
  --vm-accent-grad: linear-gradient(90deg, #409eff, #36cfc9, transparent);

  --vm-shadow-card: 0 2px 10px rgba(31, 45, 61, 0.05), 0 10px 24px -18px rgba(31, 45, 61, 0.3);
  --vm-shadow-btn: 0 12px 24px -14px rgba(51, 126, 204, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.18);
}
