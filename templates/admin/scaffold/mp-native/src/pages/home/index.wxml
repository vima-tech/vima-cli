<view class="vm-page {{aging ? 'vm-aging' : ''}}">

  <view class="vm-hero">
    <view class="vm-hero-fx"></view>
    <view class="vm-hero-glow"></view>
    <view class="vm-hero-body">
      <view class="vm-badge"><view class="vm-badge-dot"></view>服务运行中</view>
      <view class="vm-hero-title">{{appName}}</view>
      <view class="vm-hero-sub">
        <view class="vm-hero-rule-l"></view>PATIENT SERVICE<view class="vm-hero-rule-r"></view>
      </view>
    </view>
  </view>

  <view class="vm-sheet">
    <view class="vm-sec">
      <view class="vm-sec-dot"></view>
      <text class="vm-sec-title">常用服务</text>
      <text class="vm-sec-en">SERVICES</text>
    </view>

    <view class="vm-card">
      <view class="vm-grid4">
        <view class="vm-grid-item" wx:for="{{entries}}" wx:key="key">
          <view class="vm-grid-icon {{item.tone}}"></view>
          <text class="vm-grid-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="vm-sec">
      <view class="vm-sec-dot green"></view>
      <text class="vm-sec-title">最近动态</text>
      <text class="vm-sec-en">RECENT</text>
    </view>

    <view class="vm-card">
      <view class="vm-empty slim">
        <view class="vm-empty-icon">📋</view>
        <view class="vm-empty-text">暂无动态</view>
        <view class="vm-empty-hint">开始使用后，这里会显示你的最新记录</view>
      </view>
    </view>

    <view class="vm-footnote">
      <view class="vm-footnote-brand">{{appName}}</view>
    </view>
  </view>

</view>
