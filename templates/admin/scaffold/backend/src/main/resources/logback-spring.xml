<?xml version="1.0" encoding="UTF-8"?>
<!--
  应用日志落盘配置。三个参数都从 application.yml 的 log.* 读取，调参不用改本文件：
    log.dir           日志目录
    log.max-file-size 单个文件大小上限，当天写满即顺延下一段（.0 .1 .2 …）
    log.retain-days   保留天数

  分工：本文件只负责「按天 + 按大小分段」；「超过 N 天压缩」与「超过保留天数删除」
  由 LogArchiveJob（jobKey=logArchive）完成。之所以不用 logback 自带的 .gz 滚动名，
  是为了让最近若干天的日志保持纯文本，可直接 tail / grep。
-->
<configuration>
    <!-- 日志文件名取 spring.application.name，与 LogArchiveJob 推导归档前缀的来源同一个。
         这里若写死项目名，改了 spring.application.name 后归档任务会匹配不到文件而静默失效 -->
    <springProperty scope="context" name="LOG_NAME" source="spring.application.name" defaultValue="app"/>
    <springProperty scope="context" name="LOG_DIR" source="log.dir" defaultValue="./logs"/>
    <springProperty scope="context" name="LOG_MAX_FILE_SIZE" source="log.max-file-size" defaultValue="50MB"/>
    <springProperty scope="context" name="LOG_RETAIN_DAYS" source="log.retain-days" defaultValue="30"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前正在写的文件，恒定这一个名字，方便 tail -f -->
        <file>${LOG_DIR}/${LOG_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 按天切；同一天写满 maxFileSize 再按 %i 继续切分 -->
            <fileNamePattern>${LOG_DIR}/${LOG_NAME}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <!-- 兜底：LogArchiveJob 被停用时，未压缩的滚动文件仍按天数清理。
                 已压缩的 .log.gz 不匹配本模式，由 LogArchiveJob 负责删除 -->
            <maxHistory>${LOG_RETAIN_DAYS}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
